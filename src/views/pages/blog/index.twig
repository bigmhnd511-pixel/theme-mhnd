{#
| Blog index — SEO/GEO server-rendered layout
#}
{% extends "layouts.master" %}

{% block content %}
<div class="blog-seo-page">
  <nav class="breadcrumbs w-full">
    <salla-breadcrumb></salla-breadcrumb>
  </nav>

  <header class="blog-seo-intro">
    <h1>{{ page.title }}</h1>
    <p>
      شروحات وتجارب تقنية عملية حول الايفون وتحديثات iOS والشحن والملحقات،
      بخطوات واضحة ومعلومات محدثة تساعدك على حل المشكلة واختيار المنتج المناسب.
    </p>
  </header>

  {% if categories|length %}
    <section aria-labelledby="blog-topics-title">
      <h2 id="blog-topics-title" class="blog-seo-section-title">تصفح حسب الموضوع</h2>
      <nav class="blog-seo-topics" aria-label="تصنيفات المدونة">
        {% for category in categories %}
          <a
            class="blog-seo-topic{{ category.is_current ? ' is-active' : '' }}"
            href="{{ category.url }}"
          >
            {{ category.name }}
          </a>
        {% endfor %}
      </nav>
    </section>
  {% endif %}

  {% if articles|length %}
    <section aria-labelledby="latest-guides-title">
      <h2 id="latest-guides-title" class="blog-seo-section-title">أحدث الأدلة والشروحات</h2>

      {% hook 'blog:index.items.start' %}

      <salla-infinite-scroll
        class="blog-seo-feed"
        next-page="{{ articles.next_page }}"
        autoload
      >
        {% for article in articles %}
          <article data-testid="store-blog-article-card" class="blog-seo-card">
            <a href="{{ article.url }}">{{ article.title }}</a>
          </article>
        {% endfor %}
      </salla-infinite-scroll>

      {% hook 'blog:index.items.end' %}
    </section>
  {% else %}
    <div class="no-content-placeholder">
      <i class="sicon-inbox icon"></i>
      <p>{{ trans('pages.blog_categories.no_articles') }}</p>
    </div>
  {% endif %}
</div>
{% endblock %}
